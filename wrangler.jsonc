{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hardwareclub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Only the custom domains under "routes" are served: Turnstile will not
  // render on a *.workers.dev or preview hostname.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every request, static assets included, goes through src/index.ts so
    // the security headers in src/security.ts apply to all responses.
    "run_worker_first": true
  },
  "vars": {
    "TURNSTILE_SITEKEY": "1x00000000000000000000AA",
    "NOTIFY_TO": "randalwadejr@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hardwareclub-submissions",
      "database_id": "58629061-650e-452e-9b94-4bdca497a8a8"
    }
  ],
  "send_email": [
    {
      "name": "NOTIFY",
      "destination_address": "randalwadejr@gmail.com"
    }
  ],
  "routes": [
    { "pattern": "hardwareclub.org", "custom_domain": true },
    { "pattern": "www.hardwareclub.org", "custom_domain": true }
  ]
}
