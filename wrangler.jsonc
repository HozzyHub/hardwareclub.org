{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hardwareclub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Only the custom domains under "routes" are served: Turnstile will not
  // render on a *.workers.dev or preview hostname.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 0 1 * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every request, static assets included, goes through src/index.ts so
    // the security headers in src/security.ts apply to all responses.
    "run_worker_first": true
  },
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAAFFbM__n4NKHEDPH",
    "NOTIFY_TO": "randalwadejr@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hardwareclub-submissions",
      "database_id": "58629061-650e-452e-9b94-4bdca497a8a8"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMIT",
      "namespace_id": "2026092701",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "send_email": [
    {
      "name": "NOTIFY",
      "destination_address": "randalwadejr@gmail.com"
    }
  ],
  // `wrangler dev` otherwise rewrites local requests to the first route's
  // host (http://hardwareclub.org), which the Worker treats as production:
  // it would redirect to https and refuse the Turnstile test keys.
  "dev": { "host": "localhost" },
  "routes": [
    { "pattern": "hardwareclub.org", "custom_domain": true },
    { "pattern": "www.hardwareclub.org", "custom_domain": true }
  ]
}
